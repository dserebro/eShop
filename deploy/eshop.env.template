# eShop Environment Configuration
# Copy this file to /etc/eshop/eshop.env and update values for your environment.
# Ensure restricted permissions: chmod 600 /etc/eshop/eshop.env

# PostgreSQL connection strings
ConnectionStrings__catalogdb=Host=localhost;Database=catalogdb;Username=eshop;Password=eshoppass
ConnectionStrings__orderingdb=Host=localhost;Database=orderingdb;Username=eshop;Password=eshoppass
ConnectionStrings__identitydb=Host=localhost;Database=identitydb;Username=eshop;Password=eshoppass
ConnectionStrings__webhooksdb=Host=localhost;Database=webhooksdb;Username=eshop;Password=eshoppass

# RabbitMQ connection string
ConnectionStrings__EventBus=amqp://eshop:eshoppass@localhost:5672
ConnectionStrings__eventbus=amqp://eshop:eshoppass@localhost:5672

# Redis connection string
ConnectionStrings__redis=localhost:6379

# Identity service URL
Identity__Url=http://localhost:5243
IdentityUrl=http://localhost:5243

# Service URLs for inter-service communication
Services__IdentityApi=http://localhost:5243
Services__BasketApi=http://localhost:5221
Services__CatalogApi=http://localhost:5301
Services__OrderingApi=http://localhost:5360
Services__WebhooksApi=http://localhost:5410

# ASP.NET Core environment
ASPNETCORE_ENVIRONMENT=Development
